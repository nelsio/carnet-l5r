{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vite/client", "@testing-library/jest-dom"],
    "paths": {
      "@carnet/core": ["./src/core/index.ts"]
    }
  },
  "include": ["src", "tests", "vite.config.ts", "playwright.config.ts", "eslint.config.js"],
  // Spécification du moteur : activée au lot 2, quand src/core l'implémente.
  "exclude": ["tests/core.rules.spec.ts"]
}
